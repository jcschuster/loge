```

<!-- livebook:{"attrs":"eyJlbmdpbmUiOiJlZ2dsb2ciLCJpbnB1dCI6InBhdGhzX2FzX2VnZ2xvZyIsImxhbmd1YWdlIjoiZWdnbG9nIiwib3B0aW9ucyI6eyJncmFwaCI6ZmFsc2V9LCJyb2xlcyI6e30sInNvdXJjZSI6IiIsInZhcmlhYmxlIjoiIn0","chunks":null,"kind":"Elixir.KinoLoge.Cell","livebook_object":"smart_cell"} -->

