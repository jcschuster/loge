Loge.run!(Loge.Dimacs.Engines.Cadical, "c x1, not x2, x2 or x3\np cnf 3 3\n1 0\n-2 0\n2 3 0\n",
  time_limit: 10
)
```

<!-- livebook:{"attrs":"eyJlbmdpbmUiOiJraXNzYXQiLCJpbnB1dCI6bnVsbCwibGFuZ3VhZ2UiOiJkaW1hY3MiLCJvcHRpb25zIjp7InRpbWVfbGltaXQiOjEwfSwicm9sZXMiOnt9LCJzb3VyY2UiOiJjIHgxLCBub3QgeDIsIHgyIG9yIHgzXG5wIGNuZiAzIDNcbjEgMFxuLTIgMFxuMiAzIDBcbiIsInZhcmlhYmxlIjoiIn0","chunks":null,"kind":"Elixir.KinoLoge.Cell","livebook_object":"smart_cell"} -->

```elixir
